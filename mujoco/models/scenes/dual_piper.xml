<mujoco model="dual_piper">
  <compiler angle="radian"/>

  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <model name="piper" file="../mujoco_menagerie/agilex_piper/piper.xml"/>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Two fixed-base PiPER arms facing each other across the Y axis. -->
    <frame pos="0 -0.45 0">
      <attach model="piper" prefix="left_"/>
    </frame>

    <frame pos="0 0.45 0" euler="0 0 3.141592653589793">
      <attach model="piper" prefix="right_"/>
    </frame>
  </worldbody>

  <!-- Attachment also imports each child keyframe. This explicit keyframe
       initializes both robots to the same home pose at once. -->
  <keyframe>
    <key name="home"
      qpos="0 1.57 -1.3485 0 0 0 0 0  0 1.57 -1.3485 0 0 0 0 0"
      ctrl="0 1.57 -1.3485 0 0 0 0  0 1.57 -1.3485 0 0 0 0"/>
  </keyframe>
</mujoco>
