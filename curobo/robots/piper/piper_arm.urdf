<?xml version="1.0"?>
<!--
  PiPER V100 arm kinematics matched to the MuJoCo Menagerie model used in
  ../mujoco.  The gripper is deliberately excluded from the planning DOFs;
  MuJoCo controls it separately.
-->
<robot name="piper_v100_arm">
  <link name="arm_base">
    <visual><geometry><mesh filename="meshes/dae/base_link.dae"/></geometry></visual>
    <collision><geometry><mesh filename="meshes/base_link.STL"/></geometry></collision>
  </link>

  <link name="link1">
    <visual><geometry><mesh filename="meshes/dae/link1.dae"/></geometry></visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 1.5708"/>
      <geometry><mesh filename="meshes/link1.STL"/></geometry>
    </collision>
  </link>
  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.123" rpy="0 0 -1.5708"/>
    <parent link="arm_base"/><child link="link1"/><axis xyz="0 0 1"/>
    <limit lower="-2.618" upper="2.618" effort="100" velocity="3"/>
  </joint>

  <link name="link2">
    <visual><geometry><mesh filename="meshes/dae/link2.dae"/></geometry></visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0.1"/>
      <geometry><mesh filename="meshes/link2.STL"/></geometry>
    </collision>
  </link>
  <joint name="joint2" type="revolute">
    <origin xyz="0 0 0" rpy="1.5708 -0.034907 -1.5708"/>
    <parent link="link1"/><child link="link2"/><axis xyz="0 0 1"/>
    <limit lower="0" upper="3.14" effort="100" velocity="3"/>
  </joint>

  <link name="link3">
    <visual><geometry><mesh filename="meshes/dae/link3.dae"/></geometry></visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 -1.75"/>
      <geometry><mesh filename="meshes/link3.STL"/></geometry>
    </collision>
  </link>
  <joint name="joint3" type="revolute">
    <origin xyz="0.28358 0.028726 0" rpy="0 0 0.06604341"/>
    <parent link="link2"/><child link="link3"/><axis xyz="0 0 1"/>
    <limit lower="-2.697" upper="0" effort="100" velocity="3"/>
  </joint>

  <link name="link4">
    <visual><geometry><mesh filename="meshes/dae/link4.dae"/></geometry></visual>
    <collision><geometry><mesh filename="meshes/link4.STL"/></geometry></collision>
  </link>
  <joint name="joint4" type="revolute">
    <origin xyz="-0.24221 0.068514 0" rpy="-1.5708 0 1.3826"/>
    <parent link="link3"/><child link="link4"/><axis xyz="0 0 1"/>
    <limit lower="-1.832" upper="1.832" effort="100" velocity="3"/>
  </joint>

  <link name="link5">
    <visual><geometry><mesh filename="meshes/dae/link5.dae"/></geometry></visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 -3.14"/>
      <geometry><mesh filename="meshes/link5.STL"/></geometry>
    </collision>
  </link>
  <joint name="joint5" type="revolute">
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <parent link="link4"/><child link="link5"/><axis xyz="0 0 1"/>
    <limit lower="-1.22" upper="1.22" effort="100" velocity="3"/>
  </joint>

  <link name="link6">
    <visual>
      <origin xyz="-0.002 -0.008 0" rpy="-1.57 0 0"/>
      <geometry><mesh filename="meshes/dae/camera_v3.dae"/></geometry>
    </visual>
    <collision>
      <origin xyz="-0.002 -0.008 0" rpy="-1.57 0 0"/>
      <geometry><mesh filename="meshes/dae/camera_v3.dae"/></geometry>
    </collision>
  </link>
  <joint name="joint6" type="revolute">
    <origin xyz="0 0.091 0.0014165" rpy="-1.5708 -1.5708 0"/>
    <parent link="link5"/><child link="link6"/><axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="100" velocity="3"/>
  </joint>

  <!-- Center between the fingers. This is the motion-planning TCP. -->
  <link name="gripper_center">
    <!-- Conservative envelope for the palm and fingers omitted as planning DOFs. -->
    <collision><geometry><sphere radius="0.055"/></geometry></collision>
  </link>
  <joint name="link6_to_gripper_center" type="fixed">
    <origin xyz="0 0 0.13503" rpy="1.5708 0 1.5708"/>
    <parent link="link6"/><child link="gripper_center"/>
  </joint>
</robot>
